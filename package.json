{
  "name": "cachemaindesktop",
  "productName": "CacheMainDesktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for phpCacheAdmin - a web dashboard for your favorite caching system.",
  "license": "MIT",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "fetch-php": "node scripts/fetch-php.mjs",
    "build:css": "npx @tailwindcss/cli -i webapp/assets/css/src.css -o webapp/assets/css/styles.css",
    "watch:css": "npx @tailwindcss/cli -i webapp/assets/css/src.css -o webapp/assets/css/styles.css --watch",
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "start": "electron .",
    "predist": "node scripts/fetch-php.mjs && npm run build:css",
    "dist": "electron-builder --win zip"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "latest",
    "electron-builder": "latest",
    "playwright-core": "^1.63.0"
  },
  "allowScripts": {
    "electron@44.4.5": true
  }
}
