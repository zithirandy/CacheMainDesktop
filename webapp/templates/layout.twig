<!doctype html>
<html lang="en" class="scroll-smooth dark:scheme-dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
    <title>{{ site_title }} - CacheMainDesktop</title>
    <link rel="icon" type="image/png" sizes="32x32" href="{{ config('pcapath', '') }}assets/favicon.png">
    <meta name="theme-color" content="#ffffff">
    <link rel="stylesheet" href="{{ asset('assets/css/styles.css') }}">
    <meta name="csrf-token" content="{{ csrf }}">

    {%- if colors -%}
        <style>
            :root {
            {{ colors }}
            }
        </style>
    {%- endif -%}
    <script nonce="{{ nonce }}">
        const theme = localStorage.getItem('theme') || 'system';
        let current_theme = theme;

        if (theme === 'system') {
            current_theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('color-theme', 'system');
        } else {
            document.documentElement.setAttribute('color-theme', theme);
        }

        document.documentElement.classList.toggle('dark', current_theme === 'dark');

        const panels_refresh_interval = {{ config('panelrefresh', 30) * 1000 }};
        const ajax_panels = {{ ajax_panels is defined and ajax_panels == true ? 'true' : 'false' }};
        const metrics_refresh_interval = {{ config('metricsrefresh', 30) * 1000 }};
        const live_refresh_interval = {{ min(max(config('liverefresh', 2), 1), 60) * 1000 }};
        let metrics_active_filter = '{{ config('metricstab', '1d') in ['1h', '1d', '1w', '1m'] ? config('metricstab', '1d') : '1d' }}';
        const decimalsep = '{{ config('decimalsep', ',')|e('js') }}';
        const thousandssep = '{{ config('thousandssep', ' ')|e('js') }}';
    </script>
</head>
<body class="pca-app flex h-screen overflow-hidden text-gray-900 bg-gray-100 dark:text-gray-200 dark:bg-gray-950" data-dashboard="{{ current }}">

<div id="alerts" class="pca-alerts"></div>

<aside class="pca-sidebar shrink-0 flex flex-col w-56 overflow-y-auto bg-white border-r border-gray-200 dark:bg-gray-900 dark:border-gray-800">
    <div class="flex gap-2 items-center px-4 pt-5 pb-4">
        <span class="pca-logo-badge flex justify-center items-center size-9 rounded-xl text-white"
              style="background: linear-gradient(135deg, var(--color-primary-500, #64748b), var(--color-primary-700, #334155));">
            {{ svg('dashboards/redis', 18) }}
        </span>
        <span class="min-w-0">
            <span class="block text-sm font-bold tracking-tight text-gray-900 dark:text-white">CacheMain</span>
            <span class="block text-[11px] text-gray-500 dark:text-gray-400">Desktop</span>
        </span>
    </div>

    <nav class="pca-nav flex flex-col gap-0.5 px-3 mt-1" aria-label="Dashboards">
        {% for link, item in nav %}
            {% set item_color = item.colors ? item.colors.500 : 'var(--color-primary-500, #64748b)' %}
            <a class="pca-nav-item group flex relative gap-3 items-center py-2 pr-3 pl-4 text-sm rounded-lg{{ current == link ? ' active' : '' }}"
               href="?dashboard={{ link }}{{ get('server') and get('dashboard') == link ? '&server=' ~ get('server') : '' }}"
               title="{{ item.title }}" style="--item-color: {{ item_color }};">
                <span class="pca-nav-icon flex justify-center items-center size-6 rounded-md">
                    {{ svg(item.icon ?? ('dashboards/' ~ item.key), 16) }}
                </span>
                <span class="truncate font-medium">{{ item.title }}</span>
            </a>
        {% endfor %}
    </nav>

    {% if servers|default %}
        <div class="px-4 pt-5 pb-2 mt-auto border-t border-gray-200 dark:border-gray-800">
            <div class="mb-2 text-[11px] font-semibold tracking-wider text-gray-400 uppercase dark:text-gray-500">Server</div>
            {{ servers|raw }}
        </div>
    {% endif %}

    <div class="px-4 pt-4 pb-4 {{ servers|default ? '' : 'mt-auto' }} border-t border-gray-200 dark:border-gray-800">
        <button type="button" id="pca-open-connections" class="hidden gap-2 items-center px-3 py-2 w-full text-sm font-medium rounded-lg border border-dashed cursor-pointer
                border-gray-300 text-gray-600 hover:bg-gray-50 hover:border-gray-400 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:border-gray-600">
            {{ svg('plus', 14) }}
            <span>Connections</span>
        </button>

        <div class="flex mt-3 overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700 [&>.active]:bg-gray-100 dark:[&>.active]:bg-gray-800 [&>.active]:text-gray-700 dark:[&>.active]:text-gray-200"
             role="group" aria-label="Theme">
            <button class="flex flex-1 justify-center items-center py-1.5 text-gray-400 cursor-pointer dark:text-gray-500" type="button" data-theme="light" title="Light">
                {{ svg('sun', 15) }}
            </button>
            <button class="flex flex-1 justify-center items-center py-1.5 text-gray-400 border-x border-gray-200 cursor-pointer dark:text-gray-500 dark:border-gray-700" type="button" data-theme="dark" title="Dark">
                {{ svg('moon', 15) }}
            </button>
            <button class="flex flex-1 justify-center items-center py-1.5 text-gray-400 cursor-pointer dark:text-gray-500" type="button" data-theme="system" title="System">
                {{ svg('system', 15) }}
            </button>
        </div>

        <div class="flex gap-1.5 items-center mt-3 text-[11px] text-gray-400 dark:text-gray-500">
            <span>v{{ version }}</span>
            <span aria-hidden="true">·</span>
            <a class="hover:text-gray-600 dark:hover:text-gray-300" href="{{ repo }}" target="_blank" rel="noopener" title="phpCacheAdmin - MIT License">phpCacheAdmin</a>
        </div>
    </div>
</aside>

<div class="flex flex-col flex-1 min-w-0">
    <main id="maincontent" class="flex flex-col flex-1 min-h-0">
        {% if side %}
            <div class="pca-workspace flex flex-col flex-1 gap-0 min-h-0 md:flex-row">
                <div class="pca-page flex flex-col flex-1 p-4 min-h-0 md:overflow-y-auto">
                    {{ dashboard|raw }}
                </div>

                <div class="pca-rail shrink-0 w-full p-4 pt-0 bg-white border-t border-gray-200 md:w-64 md:pt-4 md:overflow-y-auto md:border-t-0 md:border-l dark:bg-gray-900 dark:border-gray-800">
                    <div class="md:sticky md:top-0">
                        {{ side|raw }}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="flex flex-col flex-1 p-4 min-h-0 overflow-y-auto">
                {{ dashboard|raw }}
            </div>
        {% endif %}
    </main>
</div>

{% if auth_warning|default(false) %}{{ include('partials/auth_warning.twig') }}{% endif %}
{{ modals|raw }}
<script src="{{ asset('assets/js/scripts.js') }}"></script>
<script nonce="{{ nonce }}">
    // Desktop shell bridge: show the Connections entry only when the page runs
    // inside the Electron window, and route the click to the shell.
    (function () {
        const button = document.getElementById('pca-open-connections');

        if (button && window.pcaDesktop) {
            button.classList.remove('hidden');
            button.classList.add('flex');

            button.addEventListener('click', () => {
                window.pcaDesktop.openConnections();
            });
        }
    })();
</script>
</body>
</html>
